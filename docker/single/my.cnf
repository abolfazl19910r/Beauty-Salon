# ============================================================
# Mahru — MariaDB داخل کانتینر تک‌کانتینری (target «single»)
# فقط 127.0.0.1 (از بیرون کانتینر دیده نمی‌شود)؛ داده روی volume /data
# ============================================================
[mysqld]
user                  = mysql
datadir               = /data/mysql
socket                = /run/mysqld/mysqld.sock
bind-address          = 127.0.0.1
port                  = 3306
skip-name-resolve
# پیکربندی پیش‌فرض Alpine (mariadb-server.cnf) skip-networking دارد؛ PHP با TCP به 127.0.0.1 وصل می‌شود
skip-networking       = 0

character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

max_connections       = 80
wait_timeout          = 600

# حافظه‌ی کم: روی لپ‌تاپ/سرور کوچک کنار php-fpm و workerها
innodb_buffer_pool_size        = 128M
innodb_log_file_size           = 48M
innodb_flush_log_at_trx_commit = 1

slow_query_log        = 1
slow_query_log_file   = /data/logs/mariadb-slow.log
long_query_time       = 2

default-time-zone     = '+03:30'

[client]
socket                = /run/mysqld/mysqld.sock
default-character-set = utf8mb4
