# ============================================================
# Beauty Salon - MySQL Configuration
# پشتیبانی کامل از UTF8MB4 برای متن فارسی
# ============================================================

[mysqld]
# ─── Character Set (فارسی) ────────────────────────────────
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci
skip-character-set-client-handshake

# ─── Connection ──────────────────────────────────────────
max_connections       = 200
connect_timeout       = 10
wait_timeout          = 600
interactive_timeout   = 600

# ─── InnoDB ──────────────────────────────────────────────
innodb_buffer_pool_size   = 256M
innodb_log_file_size      = 64M
innodb_flush_method       = O_DIRECT
innodb_flush_log_at_trx_commit = 1

# ─── Query Cache ─────────────────────────────────────────
# (در MySQL 8 حذف شده، اینجا فقط برای نمایش)
# query_cache_type    = 0

# ─── Binary Log (برای backup/replication) ────────────────
# binlog_format       = ROW
# expire_logs_days    = 7

# ─── Slow Query Log ──────────────────────────────────────
slow_query_log        = 1
long_query_time       = 2
log_queries_not_using_indexes = 0

# ─── Timezone ────────────────────────────────────────────
default-time-zone     = '+03:30'

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
