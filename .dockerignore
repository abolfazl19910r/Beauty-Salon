# ============================================================
# Beauty Salon - .dockerignore
# ============================================================

# Git
.git
.gitignore
.gitattributes

# Docker files خودش
# ⚠️ پوشه‌ی docker/ عمداً اینجا نیست: Dockerfile فایل‌های docker/php، docker/nginx، docker/supervisor و
# docker/entrypoint.sh رو COPY می‌کنه و با ignore شدنش build از همون اول شکست می‌خورد.
docker-compose*.yml
Dockerfile

# ⚠️ خروجی‌های محلی که نباید روی خروجی مراحل build بنشینن (COPY . . بعد از کپی vendor و public/build اجرا می‌شه):
# vendor محلی (با پکیج‌های dev)، build قدیمی Vite، symlink storage ویندوز، و کش provider/package محلی که با
# --no-dev ناسازگاره (کلاس پکیج dev پیدا نمی‌شه و برنامه boot نمی‌شه).
vendor/
public/build/
public/hot
public/storage
bootstrap/cache/*.php

# Node
node_modules/
npm-debug.log*

# Laravel
.env
.env.*
!.env.example
storage/app/public/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*

# Tests
tests/
phpunit.xml

# Development tools
.phpunit.cache
.php-cs-fixer.cache

# Docs
README.md
CHANGELOG.md
*.md

# IDE
.idea/
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db
