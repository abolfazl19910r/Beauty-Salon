# ============================================================
# Beauty Salon - Docker Environment Variables
# این فایل را کپی کنید به .env و مقادیر را پر کنید
# cp .env.docker .env
# ============================================================

# ─── App ─────────────────────────────────────────────────────
APP_NAME="Beauty Salon"
APP_ENV=production
APP_KEY=             # «make setup» خودش می‌سازه (قبل از بالا آمدن containerها)
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80

# ─── Database ────────────────────────────────────────────────
DB_DATABASE=beauty_salon
DB_USERNAME=beauty_user
DB_PASSWORD=change_this_password
DB_ROOT_PASSWORD=change_this_root_password
DB_EXTERNAL_PORT=3306   # فقط روی 127.0.0.1 سرور (برای SSH tunnel / ابزار محلی)

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=          # خالی بگذار یا پسورد بذار
REDIS_EXTERNAL_PORT=6379

# ─── پروکسی‌های مورد اعتماد ─────────────────────────────────
# پیش‌فرض cloudflare. اگر nginx/certbot روی خود سرور جلوی Docker است، شبکه‌ی Docker را هم اضافه کن:
# TRUSTED_PROXIES=cloudflare,172.16.0.0/12

# ─── Kavenegar SMS ───────────────────────────────────────────
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE_LOGIN=
KAVENEGAR_TEMPLATE_REGISTER=
KAVENEGAR_TEMPLATE_RESET=
KAVENEGAR_TEMPLATE_2FA=

# ─── Zarinpal ────────────────────────────────────────────────
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true    # در production باید false باشه

# ─── Telescope ───────────────────────────────────────────────
TELESCOPE_ENABLED=false   # در production باید false باشه
TELESCOPE_PATH=telescope

# ─── phpMyAdmin (فقط با --profile dev) ───────────────────────
PMA_PORT=8080
