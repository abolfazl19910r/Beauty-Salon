# ============================================================
# Mahru — سرور واقعی (production فعلی: پارس وی دی اس) با همان image تک‌کانتینری (docker-compose.server.yml، ۲۰۲۶-۱۰-۲۴)
# روی سرور در /srv/mahru به نام «.env.server» کپی و پر کنید (chmod 600). راهنما: docs/deployment/ARVAN_SERVER.md
#
# APP_KEY و DB_PASSWORD عمداً اینجا نیستند: کانتینر بار اول می‌سازد و در volume (/data) نگه می‌دارد؛ app.key با هر پشتیبان
# کپی می‌شود. ⚠️ خطی مثل «APP_KEY=» خالی ننویسید (مقدار خالی بر ساخته‌شده مقدم می‌شود).
# .env لوکال XAMPP را اینجا کپی نکنید (کلید و تنظیمات local دارد).
# ============================================================

APP_NAME=Mahru
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_URL=https://arisheh.ir

# ساب‌دامین سالن‌ها {slug}.arisheh.ir — گواهی *.arisheh.ir روی خود سرور با acme.sh (راهنما، بخش ۸الف) همه را پوشش می‌دهد.
# اگر گواهی wildcard ندارید خالی بگذارید تا لینک‌ها فقط /s/{slug} باشند.
CENTRAL_DOMAIN=arisheh.ir
# بررسی امنیتی M5: SESSION_DOMAIN دیگر خوانده نمی‌شود — کوکی همیشه فقط مال همان میزبان (روی HTTPS با پیشوند __Host-)؛
# /s/{slug} روی دامنه‌ی اصلی به زیردامنه می‌رود.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BRAND_NAME="ماهرو"
BRAND_NAME_EN=Mahru
BRAND_DOMAIN=arisheh.ir
# تماس صفحه‌ی فروش و صندوق «درخواست دمو» (پیش‌فرض؛ «تنظیمات پلتفرم» ابرمدیر بر این‌ها مقدم است)
BRAND_EMAIL=
BRAND_DEMO_NOTIFY_EMAIL=

# لبه‌های CDN آروان (فقط از آن‌ها X-Forwarded-For و X-Forwarded-Proto پذیرفته می‌شود). هرگز «*» نگذارید.
# با deploy/single/arvan-ips.sh از فهرست رسمی آروان پر می‌شود. خالی = بدون CDN (به هیچ پروکسی اعتماد نمی‌شود).
# شروع بدون CDN (رکوردهای DNS آروان با ابر خاموش): خالی بماند. وقتی ابر را روشن کردیم: bash deploy/single/arvan-ips.sh
TRUSTED_PROXIES=

DB_DATABASE=mahru
DB_USERNAME=mahru

# سرور واقعی: بدون داده‌ی نمونه — بعد از بالا آمدن: superadmin:create (راهنما)
MAHRU_SEED=false

# پشتیبان شبانه داخل کانتینر در /data/backups (= /srv/mahru/backups روی سرور، برای دانلود با WinSCP)
BACKUP_AT=03:40
BACKUP_KEEP=3
# ⭐ پشتیبان رمزنگاری‌شده (بسته‌ی مجوز 5د): کلید عمومی age (age1…)؛ کلید خصوصی فقط روی ویندوز خودتان (جدا از APP_KEY)
# ساخت کلید: docs/deployment/BACKUP.md. بدون کلید، سرور پشتیبان نمی‌گیرد (و server-deploy.sh پیش از پشتیبان می‌ایستد).
BACKUP_AGE_RECIPIENT=
BACKUP_REQUIRE_ENCRYPTION=true
BACKUP_STALE_HOURS=36

# HSTS (فقط روی HTTPS فرستاده می‌شود؛ پیش‌فرض یک سال با همه‌ی ساب‌دامین‌ها). هفته‌های اول یک روز، تا HTTPS روی دامنه‌ی اصلی و
# همه‌ی ساب‌دامین‌ها (گواهی wildcard) مطمئن شود؛ بعد این خط را بردارید تا یک سال شود.
HSTS_MAX_AGE=86400

LOG_CHANNEL=stack
# stderr: «docker logs mahru» (کد ورود وقتی SMS_LOG_ONLY=true)؛ daily: storage/logs روی volume
# در هر دو موبایل و شبا نصفه‌اند (0912***4567). کامل و ماندگار: /data/logs/security-*.log (۱۹۰ روز، ماده‌ی ۶۶۸) و
# /data/logs/payments-*.log (۳۶۵ روز)؛ هشدارهایشان در laravel/docker logs هم می‌آید. docs/deployment/LOGGING.md
# SECURITY_LOG_LEVEL و PAYMENTS_LOG_LEVEL را ننویسید (پیش‌فرض info)؛ LOG_MASK_PERSONAL_DATA=false هرگز روی سرور.
LOG_STACK=daily,stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=14

MAIL_MAILER=log

# ⭐ پیامک: تا آماده شدن خط و قالب‌های کاوه‌نگار هیچ پیامکی واقعاً نمی‌رود؛ متن و کد ورود فقط در لاگ:
#   docker logs mahru 2>&1 | grep SMS
SMS_LOG_ONLY=true
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=2000660110
KAVENEGAR_SEND_IN_LOCAL=false
# سقف ارسال کد تأیید (بررسی امنیتی H4، «پمپاژ پیامک»): هر شماره در ۱۰ دقیقه و در روز، هر IP در ساعت، کل پلتفرم در روز (۰ = بی سقف).
# خالی = پیش‌فرض ۳ / ۱۰ / ۳۰ / ۲۰۰۰. با پر شدن سقف پلتفرم ارسال کد تا فردا متوقف و به ابرمدیر اعلان می‌شود.
OTP_PER_PHONE_10MIN=
OTP_PER_PHONE_DAY=
OTP_PER_IP_HOUR=
OTP_PLATFORM_DAILY=
# پنل ابرمدیر (/superadmin) فقط از این IPها (با کاما؛ IP یا CIDR). خالی = همه. IP دیگر ← ۴۰۴ (بررسی امنیتی M4)
SUPERADMIN_ALLOWED_IPS=
KAVENEGAR_TEMPLATE_LOGIN=login-verify
KAVENEGAR_TEMPLATE_REGISTER=register-verify
KAVENEGAR_TEMPLATE_RESET=reset-password
KAVENEGAR_TEMPLATE_2FA=two-factor-auth

# زرین‌پال: sandbox تا go-live
ZARINPAL_SANDBOX=true
# «اتصال حساب زرین‌پال» (OAuth)؛ client_id از پشتیبانی زرین‌پال — خالی = خاموش
ZARINPAL_CONNECT_CLIENT_ID=
ZARINPAL_CONNECT_REDIRECT_URI=
ZARINPAL_CONNECT_MCC_ID=
# درگاه‌های روشن در پلتفرم (config/payments.php)؛ بقیه پنهان‌اند. مثلاً zarinpal,zibal
PAYMENT_ENABLED_DRIVERS=zarinpal
ZARINPAL_MERCHANT_ID=

# پوش: فایل حساب سرویس فایربیس را داخل volume کپی کنید (راهنما)
PUSH_FCM_CREDENTIALS=storage/app/private/mahru-fcm-sa.json
# پیش از اولین ذخیره در «تنظیمات پلتفرم»: آزمایشی (رسیدها سنجیده می‌شوند، پیامک همچنان می‌رود)
PUSH_MODE=shadow

# اپ‌ها (بسته‌ی ۵): اثرانگشت SHA-256 کلید امضای اپ مشتری (ir.mahru) — در /.well-known/assetlinks.json منتشر می‌شود تا
# لینک سالن (https://arisheh.ir/s/… و ساب‌دامین‌ها) مستقیم اپ را باز کند. کلید امضای EAS ‏(abolfazl19910rs-team). خالی = همیشه وب.
CUSTOMER_APP_SHA256_FINGERPRINTS=C2:6F:D4:BD:B7:18:FB:8A:88:2E:D0:36:25:20:15:B5:BD:F6:2F:DD:B9:F2:56:8C:02:84:54:67:D2:DB:51:2C
# سقف APK در «نسخه‌های اپ» (مگابایت؛ php.ini و nginx کانتینر تا ۱۵۰/۱۶۰)
APP_RELEASE_MAX_MB=150

TELESCOPE_ENABLED=false
BOT_ENABLED=false
