# ============================================================
# Mahru — سرور واقعی آروان با همان image تک‌کانتینری (docker-compose.server.yml، ۲۰۲۶-۱۰-۲۴)
# روی سرور در /srv/mahru به نام «.env.server» کپی و پر کنید (chmod 600). راهنما: docs/deployment/ARVAN_SERVER.md
#
# APP_KEY و DB_PASSWORD عمداً اینجا نیستند: کانتینر بار اول می‌سازد و در volume (/data) نگه می‌دارد؛ app.key با هر پشتیبان
# کپی می‌شود. ⚠️ خطی مثل «APP_KEY=» خالی ننویسید (مقدار خالی بر ساخته‌شده مقدم می‌شود).
# .env لوکال XAMPP را اینجا کپی نکنید (کلید و تنظیمات local دارد).
# ============================================================

APP_NAME=Mahru
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_URL=https://arisheh.ir

# ساب‌دامین سالن‌ها {slug}.arisheh.ir — فقط وقتی گواهی *.arisheh.ir در CDN صادر شد (راهنما، گام «SSL»).
# تا آن موقع خالی بگذارید تا لینک‌ها فقط /s/{slug} باشند (SESSION_DOMAIN هم خالی).
CENTRAL_DOMAIN=arisheh.ir
SESSION_DOMAIN=.arisheh.ir
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BRAND_NAME="ماهرو"
BRAND_NAME_EN=Mahru
BRAND_DOMAIN=arisheh.ir

# لبه‌های CDN آروان (فقط از آن‌ها X-Forwarded-For و X-Forwarded-Proto پذیرفته می‌شود). هرگز «*» نگذارید.
# با deploy/single/arvan-ips.sh از فهرست رسمی آروان پر می‌شود. خالی = بدون CDN (به هیچ پروکسی اعتماد نمی‌شود).
TRUSTED_PROXIES=

DB_DATABASE=mahru
DB_USERNAME=mahru

# سرور واقعی: بدون داده‌ی نمونه — بعد از بالا آمدن: superadmin:create (راهنما)
MAHRU_SEED=false

# پشتیبان شبانه داخل کانتینر در /data/backups (= /srv/mahru/backups روی سرور، برای دانلود با WinSCP)
BACKUP_AT=03:40
BACKUP_KEEP=3
# ⭐ پشتیبان رمزنگاری‌شده (بسته‌ی مجوز 5د): کلید عمومی age (age1…)؛ کلید خصوصی فقط روی ویندوز خودتان (جدا از APP_KEY)
# ساخت کلید: docs/deployment/BACKUP.md. بدون کلید، سرور پشتیبان نمی‌گیرد (و server-deploy.sh پیش از پشتیبان می‌ایستد).
BACKUP_AGE_RECIPIENT=
BACKUP_REQUIRE_ENCRYPTION=true
BACKUP_STALE_HOURS=36

LOG_CHANNEL=stack
# stderr: «docker logs mahru» (کد ورود وقتی SMS_LOG_ONLY=true)؛ daily: storage/logs روی volume
LOG_STACK=daily,stderr
LOG_LEVEL=info
LOG_DAILY_DAYS=14

MAIL_MAILER=log

# ⭐ پیامک: تا آماده شدن خط و قالب‌های کاوه‌نگار هیچ پیامکی واقعاً نمی‌رود؛ متن و کد ورود فقط در لاگ:
#   docker logs mahru 2>&1 | grep SMS
SMS_LOG_ONLY=true
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=2000660110
KAVENEGAR_SEND_IN_LOCAL=false
KAVENEGAR_TEMPLATE_LOGIN=login-verify
KAVENEGAR_TEMPLATE_REGISTER=register-verify
KAVENEGAR_TEMPLATE_RESET=reset-password
KAVENEGAR_TEMPLATE_2FA=two-factor-auth

# زرین‌پال: sandbox تا go-live
ZARINPAL_SANDBOX=true
ZARINPAL_PAYOUT_SANDBOX=true
# درگاه‌های روشن در پلتفرم (config/payments.php)؛ بقیه پنهان‌اند. مثلاً zarinpal,zibal
PAYMENT_ENABLED_DRIVERS=zarinpal
ZARINPAL_MERCHANT_ID=

# پوش: فایل حساب سرویس فایربیس را داخل volume کپی کنید (راهنما)
PUSH_FCM_CREDENTIALS=storage/app/private/mahru-fcm-sa.json

TELESCOPE_ENABLED=false
BOT_ENABLED=false
