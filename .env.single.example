# ============================================================
# Mahru — تنظیمات حالت تک‌کانتینری (docker-compose.single.yml)
# این فایل را به .env.single کپی کنید. .env.single در git نمی‌رود.
#
# APP_KEY و DB_PASSWORD عمداً اینجا نیستند: کانتینر بار اول خودش می‌سازد و روی volume (/data) نگه می‌دارد.
# ⚠️ آن‌ها را خالی («APP_KEY=») ننویسید: متغیر خالی بر مقدار ساخته‌شده مقدم می‌شود و «docker compose exec … artisan» کار نمی‌کند.
# اگر رمز دلخواه می‌خواهید، با مقدار کامل بنویسید.
# ============================================================

APP_NAME=Mahru
# آزمون لوکال: local — پیامک واقعی نمی‌رود و کد ورود در لاگ دیده می‌شود (راهنما). سرور واقعی: production و APP_DEBUG=false
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

# آدرسی که لینک‌ها (پیامک، بازگشت درگاه، اپ) با آن ساخته می‌شوند.
# Docker Desktop لوکال، از مرورگر همین سیستم:   http://arisheh.test:8080
# از گوشی روی همان وای‌فای:                     http://192.168.1.2:8080   (IP سیستم شما)
APP_URL=http://arisheh.test:8080

# ساب‌دامین سالن‌ها: {slug}.arisheh.test — هر سالن یک خط در فایل hosts ویندوز (راهنما). خالی = فقط /s/{slug}
CENTRAL_DOMAIN=arisheh.test
SESSION_DOMAIN=.arisheh.test
SESSION_SECURE_COOKIE=false

BRAND_NAME="ماهرو"
BRAND_NAME_EN=Mahru
BRAND_DOMAIN=arisheh.ir

# دیتابیس داخل کانتینر. رمز ساخته می‌شود و در /data/db.password می‌ماند (بالا را ببینید).
DB_DATABASE=mahru
DB_USERNAME=mahru

# true = بار اول داده‌ی نمونه (سالن راستا، متخصص‌ها، خدمات، ...) — فقط برای آزمون لوکال. روی سرور واقعی false.
MAHRU_SEED=true

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

MAIL_MAILER=log

# پیامک: در APP_ENV=local با SEND_IN_LOCAL=false پیامک واقعی نمی‌رود و متن (و کد ورود) در storage/logs ثبت می‌شود
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=2000660110
KAVENEGAR_SEND_IN_LOCAL=false
KAVENEGAR_TEMPLATE_LOGIN=login-verify
KAVENEGAR_TEMPLATE_REGISTER=register-verify
KAVENEGAR_TEMPLATE_RESET=reset-password
KAVENEGAR_TEMPLATE_2FA=two-factor-auth

ZARINPAL_SANDBOX=true
ZARINPAL_PAYOUT_SANDBOX=true
ZARINPAL_MERCHANT_ID=

# پوش: فایل حساب سرویس فایربیس را داخل volume کپی کنید (راهنما) — مسیر داخل کانتینر:
PUSH_FCM_CREDENTIALS=storage/app/private/mahru-fcm-sa.json

TELESCOPE_ENABLED=false
BOT_ENABLED=false
