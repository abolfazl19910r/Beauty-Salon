APP_NAME=Laravel
# ⭐ نام نمایشی پلتفرم (config/brand.php) — جدا از APP_NAME، که اسم کوکی session از آن ساخته می‌شود
BRAND_NAME="ماهرو"
BRAND_NAME_EN=Mahru
BRAND_DOMAIN=arisheh.ir
# تماس و شبکه‌های صفحه‌ی فروش (config/brand.php) — فقط مقدار پیش‌فرض؛ «تنظیمات پلتفرم» سوپرادمین بر این‌ها مقدم است. خالی = پنهان
BRAND_SUPPORT_PHONE=
BRAND_EMAIL=
BRAND_INSTAGRAM_URL=
BRAND_LINKEDIN_URL=
BRAND_TELEGRAM_URL=
BRAND_BALE_URL=
# صندوق دریافت ایمیل «درخواست دمو» (ارسال واقعی فقط با MAIL_* درست، نه MAIL_MAILER=log)
BRAND_DEMO_NOTIFY_EMAIL=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://127.0.0.1:8000

# آدرس جدای هر سالن به‌شکل ساب‌دامین: {slug}.CENTRAL_DOMAIN. سرور: arisheh.ir با DNS ستاره‌ای (*.arisheh.ir).
# سیستم محلی: خالی بگذارید (سالن‌ها با /s/{slug} باز می‌شوند؛ این آدرس همیشه کار می‌کند). ساب‌دامین محلی دامنه‌ای می‌خواهد که روی
# گوشی به IP سیستم برسد؛ nip.io/sslip.io از ایران در دسترس نیستند.
CENTRAL_DOMAIN=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beauty_salon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
# هاست بدون supervisor (DirectAdmin): true = همون کرون schedule:run صف رو هم اجرا می‌کنه.
# Docker یا سرور با queue:work دائمی: false. راهنما: docs/deployment/SCHEDULER_AND_QUEUE.md
QUEUE_WORK_VIA_SCHEDULER=false

# هرگز array: چالش ورود اپ و محدودیت نرخ بین دو درخواست گم می‌شوند (file یا database یا redis)
CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_API_KEY=your-api-key
ZARINPAL_SANDBOX=true
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com/pg/v4

ZARINPAL_PAYOUT_API_KEY=your_payout_api_key
ZARINPAL_PAYOUT_SANDBOX=true

SUBSCRIPTION_PRICE_1M=1500000
SUBSCRIPTION_PRICE_3M=4150000
SUBSCRIPTION_PRICE_6M=7650000
SUBSCRIPTION_PRICE_12M=13850000

# دامنه‌ی لینک کوتاه پیامک‌ها (خالی = CENTRAL_DOMAIN یا APP_URL)؛ کوتاه‌تر = پیامک ارزان‌تر
SMS_LINK_HOST=
# سهمیه‌ی پیامک ماهانه‌ی هر سالن بر حسب «قطعه» (مثل فاکتور کاوه‌نگار)
SMS_QUOTA_PER_MONTH=2000
# بسته‌ی پیامک اضافه: قیمت هر قطعه (تومان، بدون تخفیف) و اندازه‌ی بسته‌ها (قطعه)
SMS_PART_PRICE=320
SMS_PACKS=1000,2500,5000

INCLUDED_SPECIALISTS_COUNT=10
EXTRA_SPECIALIST_PRICE_PER_MONTH=250000
MAX_SIGNUP_SPECIALISTS=50

SUBSCRIPTION_TRIAL_DAYS=14

TRIAL_SMS_QUOTA=400



KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=2000660110
# true = در محیط local هم پیامک واقعی ارسال شود (تست‌ها همیشه false هستند — phpunit.xml)
KAVENEGAR_SEND_IN_LOCAL=false
# true = پیامک در هیچ محیطی (حتی production) به کاوه‌نگار نمی‌رود؛ متن و کد ورود فقط در لاگ
SMS_LOG_ONLY=false


KAVENEGAR_TEMPLATE_LOGIN=login-verify
KAVENEGAR_TEMPLATE_REGISTER=register-verify
KAVENEGAR_TEMPLATE_RESET=reset-password
KAVENEGAR_TEMPLATE_2FA=two-factor-auth

SECURITY_LOG_LEVEL=
PAYMENTS_LOG_LEVEL=

TWO_FACTOR_TIMEOUT=
TWO_FACTOR_CODE_LENGTH=

MAX_LOGIN_ATTEMPTS=
LOGIN_THROTTLE_MINUTES=

VERIFICATION_CODE_EXPIRE_MINUTES=
RESET_CODE_EXPIRE_MINUTES=

PAYMENT_EXPIRY_MINUTES=

# پروکسی‌های مورد اعتماد (config/trustedproxy.php): خالی = هیچ (بدون CDN، IP مستقیم واقعی است)؛ IP/CIDR با کاما،
# cloudflare یا none. پشت CDN آروان: deploy/single/arvan-ips.sh
# TRUSTED_PROXIES=

# HSTS فقط روی HTTPS فرستاده می‌شود (config/security.php)؛ 0 = خاموش. خالی = یک سال، با ساب‌دامین‌ها
HSTS_MAX_AGE=
HSTS_INCLUDE_SUBDOMAINS=
# نگهداری داده (config/retention.php، ماده‌ی ۶۶۸ آیین دادرسی کیفری): خالی = ۱۹۰ روز؛ کمتر از ۱۸۴ پذیرفته نمی‌شود.
# جدا: RETENTION_SECURITY_LOGS_DAYS (جدول)، RETENTION_ACCESS_LOG_DAYS (لاگ nginx)، SECURITY_LOG_DAYS (فایل security.log)
RETENTION_DAYS=
# CSP: report (پیش‌فرض، فقط گزارش در storage/logs/csp-*.log)، enforce یا off
SECURITY_CSP=

TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope

# ربات پلتفرم (بله + تلگرام): توکن خالی = آن پیام‌رسان خاموش. username بدون @ (برای لینک /start).
# BOT_WEBHOOK_SECRET یک رشته‌ی تصادفی بلند؛ بعد: php artisan bot:webhook bale  (و telegram)
# ⚠️ از سرور داخل ایران تلگرام در دسترس نیست — فقط با سرور بیرون یا TELEGRAM_API_BASE (پراکسی)
# پوش اپ‌ها (بسته‌ی ۴): مسیر کلید حساب سرویس فایربیس (نسبی از ریشه‌ی پروژه)؛ خالی = پوش خاموش
PUSH_FCM_CREDENTIALS=
# پیش‌فرض حالت پیش از اولین ذخیره در «تنظیمات پلتفرم» ابرمدیر: off | shadow | live
PUSH_MODE=shadow
# data (پیش‌فرض؛ اپ اعلان را می‌سازد و رسید می‌فرستد) | notification (اگر task پس‌زمینه روی گوشی‌ای اجرا نشد)
PUSH_FCM_STYLE=data
# Worker کلودفلر اگر سرور به گوگل نرسد (کیت بسته‌ی ۰)؛ خالی = مستقیم
PUSH_FCM_PROXY=
# ntfy خودمیزبان برای قطعی اینترنت بین‌الملل (سرور مجازی داخل ایران)
PUSH_NTFY_SERVER=
PUSH_NTFY_TOKEN=

# اپ‌ها بدون مارکت و PWA (بسته‌ی ۵ و ۶)
# اثرانگشت SHA-256 کلید امضای اپ مشتری (expo.dev ← mahru ← Credentials ← Android ← ir.mahru)؛ عمومی است و در
# /.well-known/assetlinks.json منتشر می‌شود. خالی = لینک سالن همیشه وب را باز می‌کند. چند کلید: با ویرگول.
CUSTOMER_APP_SHA256_FINGERPRINTS=C2:6F:D4:BD:B7:18:FB:8A:88:2E:D0:36:25:20:15:B5:BD:F6:2F:DD:B9:F2:56:8C:02:84:54:67:D2:DB:51:2C
# سقف حجم APK در «نسخه‌های اپ» ابرمدیر (مگابایت)؛ upload_max_filesize و post_max_size در php.ini هم دست‌کم همین
APP_RELEASE_MAX_MB=150
# «مرا به خاطر بسپار» ورود وب: روزهای ماندن در حساب و اعتبار دستگاه شناخته‌شده (ورود بی‌کد پیامکی)
AUTH_REMEMBER_DAYS=90
# service worker سایت سالن و پنل متخصص (با npm run dev خودکار خاموش است)
PWA_SERVICE_WORKER=true

# ربات کنار گذاشته شده (بسته‌ی ۸، ۲۰۲۶-۱۰-۲۲): false = هیچ‌جا دیده نمی‌شود و پیامی نمی‌رود؛ کد و داده‌ها می‌مانند
BOT_ENABLED=false
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# واسط Cloudflare Worker برای سرور داخل ایران (deploy/cloudflare/telegram-proxy): https://tg.arisheh.ir/<PROXY_SECRET>
# TELEGRAM_API_BASE=https://api.telegram.org
BOT_WEBHOOK_SECRET=
