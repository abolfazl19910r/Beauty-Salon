APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://127.0.0.1:8000

# محور «۳. ساب‌دامین اختصاصی» — خالی بذار تا رفتار قبلی (/s/{slug}) دست‌نخورده بمونه.
# برای تست لوکال با nip.io مقداردهی کن، مثلاً: CENTRAL_DOMAIN=127.0.0.1.nip.io
# (به docs/WILDCARD_SUBDOMAIN_DEPLOYMENT.md برای راهنمای کامل production نگاه کن)
CENTRAL_DOMAIN=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beauty_salon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
# اگه CENTRAL_DOMAIN (بالا) رو پر کردی، این باید مشترک بین ساب‌دامین‌ها باشه، وگرنه لینک قدیمی
# /s/{slug} کاملاً می‌شکنه (۴۱۹ Page Expired روی فرم لاگین) — به docs/WILDCARD_SUBDOMAIN_DEPLOYMENT.md
# (قدم ۴) نگاه کن. مثلاً: SESSION_DOMAIN=.yourdomain.com
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=array
CACHE_PREFIX=
CACHE_DRIVER=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_API_KEY=your-api-key
ZARINPAL_SANDBOX=true
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com/pg/v4

ZARINPAL_PAYOUT_API_KEY=your_payout_api_key
ZARINPAL_PAYOUT_SANDBOX=true

# قیمت اشتراک سالن (تومان) — فاز ۲، محور «پرداخت آنلاین و صورتحساب». محاسبه‌شده بر پایه‌ی
# هزینه‌ی واقعی پیامک (کاوه‌نگار) + زیرساخت + حاشیه‌سود؛ منطق کامل در config/billing.php.
# قبل از production با فاکتور واقعی چک/اصلاح کن.
SUBSCRIPTION_PRICE_1M=720000
SUBSCRIPTION_PRICE_3M=1990000
SUBSCRIPTION_PRICE_6M=3670000
SUBSCRIPTION_PRICE_12M=6610000

# سقف پیامک ماهانه به‌ازای هر سالن — فیچر «قطع پیامک بعد از اتمام سهمیه» (config/billing.php،
# app/Services/Sms/SmsQuotaService.php). بعد از این عدد، پیامک برای اون سالن ارسال نمی‌شه و به
# ادمین سالن/سوپرادمین اطلاع داده می‌شه.
SMS_QUOTA_PER_MONTH=1500

# سقف پیش‌فرض تعداد متخصص برای سالنی که از طریق ثبت‌نام عمومی (self-service، محور «۴») خودش
# رو می‌سازه — بعداً فقط سوپرادمین می‌تونه این عدد رو برای یک سالن خاص افزایش بده.
DEFAULT_MAX_SPECIALISTS_COUNT=3



KAVENEGAR_API_KEY=474B4E416A5959627A664C544B4363715130516739436C497865495043502F327A5150517751706C6330733D
KAVENEGAR_SENDER=2000660110
KAVENEGAR_SEND_IN_LOCAL=true


KAVENEGAR_TEMPLATE_LOGIN=login-verify
KAVENEGAR_TEMPLATE_REGISTER=register-verify
KAVENEGAR_TEMPLATE_RESET=reset-password
KAVENEGAR_TEMPLATE_2FA=two-factor-auth

SECURITY_LOG_LEVEL=
PAYMENTS_LOG_LEVEL=

TWO_FACTOR_TIMEOUT=
TWO_FACTOR_CODE_LENGTH=

MAX_LOGIN_ATTEMPTS=
LOGIN_THROTTLE_MINUTES=

VERIFICATION_CODE_EXPIRE_MINUTES=
RESET_CODE_EXPIRE_MINUTES=

PAYMENT_EXPIRY_MINUTES=

TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=