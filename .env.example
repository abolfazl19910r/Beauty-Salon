APP_NAME=Laravel
# ⭐ نام نمایشی پلتفرم (config/brand.php) — جدا از APP_NAME، که اسم کوکی session از آن ساخته می‌شود
BRAND_NAME="ماهرو"
BRAND_NAME_EN=Mahru
BRAND_DOMAIN=mahru.ir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://127.0.0.1:8000

CENTRAL_DOMAIN=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beauty_salon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
# هاست بدون supervisor (DirectAdmin): true = همون کرون schedule:run صف رو هم اجرا می‌کنه.
# Docker یا سرور با queue:work دائمی: false. راهنما: docs/deployment/SCHEDULER_AND_QUEUE.md
QUEUE_WORK_VIA_SCHEDULER=false

CACHE_STORE=array
CACHE_PREFIX=
CACHE_DRIVER=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_API_KEY=your-api-key
ZARINPAL_SANDBOX=true
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com/pg/v4

ZARINPAL_PAYOUT_API_KEY=your_payout_api_key
ZARINPAL_PAYOUT_SANDBOX=true

SUBSCRIPTION_PRICE_1M=1500000
SUBSCRIPTION_PRICE_3M=4150000
SUBSCRIPTION_PRICE_6M=7650000
SUBSCRIPTION_PRICE_12M=13850000

SMS_QUOTA_PER_MONTH=1500

DEFAULT_MAX_SPECIALISTS_COUNT=3

SUBSCRIPTION_TRIAL_DAYS=14

TRIAL_SMS_QUOTA=300



KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=2000660110
# true = در محیط local هم پیامک واقعی ارسال شود (تست‌ها همیشه false هستند — phpunit.xml)
KAVENEGAR_SEND_IN_LOCAL=false


KAVENEGAR_TEMPLATE_LOGIN=login-verify
KAVENEGAR_TEMPLATE_REGISTER=register-verify
KAVENEGAR_TEMPLATE_RESET=reset-password
KAVENEGAR_TEMPLATE_2FA=two-factor-auth

SECURITY_LOG_LEVEL=
PAYMENTS_LOG_LEVEL=

TWO_FACTOR_TIMEOUT=
TWO_FACTOR_CODE_LENGTH=

MAX_LOGIN_ATTEMPTS=
LOGIN_THROTTLE_MINUTES=

VERIFICATION_CODE_EXPIRE_MINUTES=
RESET_CODE_EXPIRE_MINUTES=

PAYMENT_EXPIRY_MINUTES=

TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=